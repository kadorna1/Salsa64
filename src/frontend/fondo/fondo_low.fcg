/*
 * Salsa64 — fondo «Shader» del menú, basado en «XdGfRR» de Shadertoy, de
 * int_45h (https://www.shadertoy.com/view/XdGfRR; ver docs/THIRD_PARTY.md).
 *
 * Desempaca la marcha y el polvo (4 columnas por texel) a un texel por
 * columna, para leerlos con filtro bilineal: x = t de parada, y = polvo
 * por 0,3 y por el factor de los bordes del original,
 * pow(0,64 + 0,46·cos(2π·u), 1,7). TEXCOORD1 = (columnas / 4, −0,25/W).
 */
void main(float4 pos : TEXCOORD0, float4 k : TEXCOORD1, uniform sampler2D marcha : TEXUNIT0,
	  uniform sampler2D polvo : TEXUNIT1, out float4 color : COLOR)
{
	float4 ts = tex2D(marcha, pos.zw);
	float4 e = tex2D(polvo, pos.zw);
	/* Columna dentro del texel: q = 0,5, 1,5, 2,5 o 3,5. */
	float q = frac(pos.z * k.x) * 4.0;
	float4 m = step(abs(q - float4(0.5, 1.5, 2.5, 3.5)), float4(0.5, 0.5, 0.5, 0.5));
	float edge = pow(0.64 + 0.46 * cos((pos.z + k.y) * 6.28), 1.7);
	color = float4(dot(ts, m), dot(e, m) * edge * 0.3, 0.0, 0.0);
}
