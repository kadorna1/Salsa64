/*
 * Salsa64 — fondo «Shader» del menú, basado en «XdGfRR» de Shadertoy, de
 * int_45h (https://www.shadertoy.com/view/XdGfRR; ver docs/THIRD_PARTY.md).
 *
 * La ola: un fragmento por cada cruce del rayo del píxel con una de las dos
 * superficies g = ±0,04 que limitan la cáscara (src/frontend/fondo_calc.h).
 * Suma s·F̃(t), con F̃ la primitiva de 0,3·smoothstep(0, 0,3, 0,009·t)
 * menos 3,5 (tabla `prim` de 256 valores en t = 0..40, fondo_prim), y s = −1
 * al entrar en la cáscara y +1 al salir (sgn.x, una copia del programa por
 * signo). La t se corta donde al rayo se le acaban los pasos
 * (fondo_marcha.fcg, ya desempacada en x de `low`).
 * TEXCOORD0 = (t, X·w, Y·w, w): con la corrección de perspectiva, yz/w es la
 * posición del fragmento en la pantalla.
 */
#define NP 256.0

void main(float4 pos : TEXCOORD0, uniform sampler2D low : TEXUNIT0, uniform sampler2D prim : TEXUNIT1,
	  uniform float4 sgn, out float4 color : COLOR)
{
	float2 uv = pos.yz * (1.0 / pos.w) * float2(0.5, -0.5) + 0.5;
	float t = min(pos.x, tex2D(low, uv).x);
	float2 c = float2(t * ((NP - 1.0) / (40.0 * NP)) + 0.5 / NP, 0.5);
	color = sgn * tex2D(prim, c).x;
}
