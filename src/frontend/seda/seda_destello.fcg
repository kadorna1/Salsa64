/*
 * Salsa64 — fondo «Seda» del menú: los destellos, puntos aditivos redondos y
 * suaves, como polvo de luz. TEXCOORD0 = (x, y de −1 a 1 en el
 * cuadrito, brillo, tono); el color sale de la rampa TEXUNIT0.
 */
void main(float4 t : TEXCOORD0, uniform sampler2D ramp : TEXUNIT0, out float4 color : COLOR)
{
	float d2 = dot(t.xy, t.xy);
	float a = saturate(1.0 - d2);
	float core = a * a;
	float3 tint = tex2D(ramp, float2(t.w * 0.9375 + 0.03125, 0.5)).rgb;
	color = float4(tint * (core * (1.6 * t.z)), 1.0);
}
