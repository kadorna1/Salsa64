/*
 * Salsa64 — fondo «Seda» del menú: la cinta de tela (src/frontend/seda_calc.h).
 * TEXCOORD0 = (|n·V|, n·H, intensidad, tono). Brillo de Fresnel (más fuerte
 * cuanto más de canto queda la tela, con la transparencia mayor de frente),
 * un especular suave (n·H elevado a la 16, del mismo tono) que corre por los pliegues y el
 * color de la rampa de la capa (TEXUNIT0, 16 × 1, tinte · ganancia). Se
 * suma al fondo (mezcla aditiva): el alfa no cuenta.
 */
#define BASE 0.032
#define FRES 0.597
#define SPEC 0.177

void main(float4 t : TEXCOORD0, uniform sampler2D ramp : TEXUNIT0, out float4 color : COLOR)
{
	float r = 1.0 - saturate(t.x);
	float fres = r * r * r;
	float s = saturate(t.y);
	float s2 = s * s;
	float s4 = s2 * s2;
	float s8 = s4 * s4;
	float s16 = s8 * s8;
	float3 tint = tex2D(ramp, float2(t.w * 0.9375 + 0.03125, 0.5)).rgb;
	float3 c = tint * (BASE + FRES * fres + SPEC * s16);
	color = float4(c * t.z, 1.0);
}
